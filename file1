//@version=4
strategy(
     "Bollinger Bands Strategy (Improved)",
     overlay=true,
     pyramiding=0,
     calc_on_order_fills=true,
     calc_on_every_tick=false,
     initial_capital=100000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=10
)

// Core settings
source = input(close, title="Source", type=input.source)
length = input(20, minval=1, title="BB Length")
mult = input(2.0, minval=0.1, maxval=10.0, title="BB StdDev")

// Entry filters
trendLength = input(200, minval=20, title="Trend EMA Length")
rsiLength = input(14, minval=2, title="RSI Length")
minRsiLong = input(45, minval=1, maxval=99, title="Min RSI for Longs")
maxRsiShort = input(55, minval=1, maxval=99, title="Max RSI for Shorts")
allowShorts = input(true, title="Allow Shorts")

// Risk controls
atrLength = input(14, minval=1, title="ATR Length")
stopAtrMult = input(1.8, minval=0.1, step=0.1, title="Stop Loss ATR Multiplier")
takeAtrMult = input(3.0, minval=0.1, step=0.1, title="Take Profit ATR Multiplier")
trailAtrMult = input(1.2, minval=0.1, step=0.1, title="Trailing Stop ATR Multiplier")
maxBarsInTrade = input(80, minval=1, title="Max Bars In Trade")

// Bollinger Bands
basis = sma(source, length)
dev = mult * stdev(source, length)
upper = basis + dev
lower = basis - dev

// Filters
trendEma = ema(source, trendLength)
rsiValue = rsi(source, rsiLength)
atrValue = atr(atrLength)

upTrend = source > trendEma and trendEma >= trendEma[1]
downTrend = source < trendEma and trendEma <= trendEma[1]

// Trade only when price re-enters the bands in the direction of the trend.
longSignal = upTrend and crossover(source, lower) and rsiValue > minRsiLong
shortSignal = allowShorts and downTrend and crossunder(source, upper) and rsiValue < maxRsiShort

// Flip protection
if (longSignal and strategy.position_size < 0)
    strategy.close("Short", comment="Flip to Long")
if (shortSignal and strategy.position_size > 0)
    strategy.close("Long", comment="Flip to Short")

if (longSignal and strategy.position_size <= 0)
    strategy.entry("Long", strategy.long, comment="BB Long")

if (shortSignal and strategy.position_size >= 0)
    strategy.entry("Short", strategy.short, comment="BB Short")

// Dynamic exits
var float longTrailStop = na
var float shortTrailStop = na
var int entryBarIndex = na

if (strategy.position_size != 0 and strategy.position_size[1] == 0)
    entryBarIndex := bar_index
if (strategy.position_size == 0)
    entryBarIndex := na

if (strategy.position_size > 0)
    baseLongStop = strategy.position_avg_price - atrValue * stopAtrMult
    nextLongTrail = close - atrValue * trailAtrMult
    longTrailStop := na(longTrailStop) ? nextLongTrail : max(longTrailStop, nextLongTrail)
    longStop = max(baseLongStop, longTrailStop)
    longTake = strategy.position_avg_price + atrValue * takeAtrMult
    strategy.exit("Long Exit", from_entry="Long", stop=longStop, limit=longTake, comment="Risk Exit")
else
    longTrailStop := na

if (strategy.position_size < 0)
    baseShortStop = strategy.position_avg_price + atrValue * stopAtrMult
    nextShortTrail = close + atrValue * trailAtrMult
    shortTrailStop := na(shortTrailStop) ? nextShortTrail : min(shortTrailStop, nextShortTrail)
    shortStop = min(baseShortStop, shortTrailStop)
    shortTake = strategy.position_avg_price - atrValue * takeAtrMult
    strategy.exit("Short Exit", from_entry="Short", stop=shortStop, limit=shortTake, comment="Risk Exit")
else
    shortTrailStop := na

timeStopHit = strategy.position_size != 0 and not na(entryBarIndex) and (bar_index - entryBarIndex >= maxBarsInTrade)
if (timeStopHit and strategy.position_size > 0)
    strategy.close("Long", comment="Time Stop")
if (timeStopHit and strategy.position_size < 0)
    strategy.close("Short", comment="Time Stop")

plot(upper, title="Upper Band", color=color.yellow, linewidth=1, style=plot.style_line, transp=20)
plot(lower, title="Lower Band", color=color.yellow, linewidth=1, style=plot.style_line, transp=20)
plot(basis, title="Basis", color=color.blue, linewidth=1, style=plot.style_line, transp=20)
plot(trendEma, title="Trend EMA", color=color.orange, linewidth=1, style=plot.style_line, transp=0)

plotshape(longSignal, title="Long Signal", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny, transp=0)
plotshape(shortSignal, title="Short Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny, transp=0)

