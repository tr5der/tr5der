//@version=6
strategy("Bollinger Bands Strategy (Performance Tuner)", overlay=true, pyramiding=0, calc_on_order_fills=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=15)

// Strategy profile
profile = input.string("Aggressive Return", "Profile", options=["Aggressive Return", "Balanced", "High Win Rate", "Custom"])
allowShorts = input.bool(false, "Allow Shorts")
longOnlyInBull = input.bool(true, "Only Longs Above Trend EMA")
useBasisExit = input.bool(true, "Exit On Basis Cross")
useSessionFilter = input.bool(false, "Use Session Filter")
sessionInput = input.session("0000-2359", "Trading Session")

// Custom values (used when Profile = Custom)
bbLengthCustom = input.int(20, "Custom BB Length", minval=1)
bbMultCustom = input.float(2.0, "Custom BB StdDev", minval=0.1, maxval=10.0, step=0.1)
emaLenCustom = input.int(150, "Custom Trend EMA Length", minval=20)
rsiLenCustom = input.int(14, "Custom RSI Length", minval=2)
rsiLongCustom = input.int(46, "Custom Min RSI Long", minval=1, maxval=99)
rsiShortCustom = input.int(54, "Custom Max RSI Short", minval=1, maxval=99)
atrLenCustom = input.int(14, "Custom ATR Length", minval=1)
stopAtrCustom = input.float(1.7, "Custom Stop ATR", minval=0.1, step=0.1)
takeAtrCustom = input.float(3.2, "Custom Target ATR", minval=0.1, step=0.1)
trailAtrCustom = input.float(1.3, "Custom Trail ATR", minval=0.1, step=0.1)
beTriggerCustom = input.float(0.9, "Custom Breakeven Trigger ATR", minval=0.1, step=0.1)
maxBarsCustom = input.int(120, "Custom Max Bars In Trade", minval=1)
minBandWidthCustom = input.float(0.12, "Custom Min Band Width %", minval=0.01, step=0.01)

// Profile mapper: looser defaults to increase trade count and PnL potential.
bbLength = profile == "Aggressive Return" ? 18 : profile == "Balanced" ? 20 : profile == "High Win Rate" ? 22 : bbLengthCustom
bbMult = profile == "Aggressive Return" ? 2.0 : profile == "Balanced" ? 2.1 : profile == "High Win Rate" ? 2.2 : bbMultCustom
emaLen = profile == "Aggressive Return" ? 120 : profile == "Balanced" ? 150 : profile == "High Win Rate" ? 180 : emaLenCustom
rsiLen = profile == "Aggressive Return" ? 12 : profile == "Balanced" ? 14 : profile == "High Win Rate" ? 14 : rsiLenCustom
rsiLongMin = profile == "Aggressive Return" ? 45 : profile == "Balanced" ? 48 : profile == "High Win Rate" ? 52 : rsiLongCustom
rsiShortMax = profile == "Aggressive Return" ? 55 : profile == "Balanced" ? 52 : profile == "High Win Rate" ? 48 : rsiShortCustom
atrLen = profile == "Aggressive Return" ? 14 : profile == "Balanced" ? 14 : profile == "High Win Rate" ? 12 : atrLenCustom
stopAtr = profile == "Aggressive Return" ? 1.9 : profile == "Balanced" ? 1.7 : profile == "High Win Rate" ? 2.1 : stopAtrCustom
takeAtr = profile == "Aggressive Return" ? 3.8 : profile == "Balanced" ? 3.0 : profile == "High Win Rate" ? 2.0 : takeAtrCustom
trailAtr = profile == "Aggressive Return" ? 1.5 : profile == "Balanced" ? 1.2 : profile == "High Win Rate" ? 0.9 : trailAtrCustom
beTriggerAtr = profile == "Aggressive Return" ? 1.1 : profile == "Balanced" ? 0.9 : profile == "High Win Rate" ? 0.6 : beTriggerCustom
maxBarsInTrade = profile == "Aggressive Return" ? 160 : profile == "Balanced" ? 120 : profile == "High Win Rate" ? 64 : maxBarsCustom
minBandWidthPct = profile == "Aggressive Return" ? 0.08 : profile == "Balanced" ? 0.12 : profile == "High Win Rate" ? 0.18 : minBandWidthCustom

source = close
basis = ta.sma(source, bbLength)
dev = bbMult * ta.stdev(source, bbLength)
upper = basis + dev
lower = basis - dev
trendEma = ta.ema(source, emaLen)
rsiVal = ta.rsi(source, rsiLen)
atrVal = ta.atr(atrLen)
bandWidthPct = (upper - lower) / math.max(math.abs(source), syminfo.mintick) * 100.0

inSession = not useSessionFilter or not na(time(timeframe.period, sessionInput))
bandOk = bandWidthPct >= minBandWidthPct
trendBull = source > trendEma
trendBear = source < trendEma
longTrendOk = not longOnlyInBull or trendBull

// Hybrid entries: combine reversion and momentum for higher opportunity count.
longReversion = ta.crossover(source, lower)
longMomentum = ta.crossover(source, basis) and source > trendEma
shortReversion = ta.crossunder(source, upper)
shortMomentum = ta.crossunder(source, basis) and source < trendEma

longSignal = inSession and bandOk and longTrendOk and (longReversion or longMomentum) and rsiVal >= rsiLongMin
shortSignal = inSession and bandOk and allowShorts and trendBear and (shortReversion or shortMomentum) and rsiVal <= rsiShortMax

if longSignal and strategy.position_size < 0
    strategy.close("Short", comment="Flip Long")
if shortSignal and strategy.position_size > 0
    strategy.close("Long", comment="Flip Short")

if longSignal and strategy.position_size <= 0
    strategy.entry("Long", strategy.long, comment="Hybrid Long")
if shortSignal and strategy.position_size >= 0
    strategy.entry("Short", strategy.short, comment="Hybrid Short")

var float longTrail = na
var float shortTrail = na
var int entryBar = na

if strategy.position_size != 0 and strategy.position_size[1] == 0
    entryBar := bar_index
if strategy.position_size == 0
    entryBar := na

if strategy.position_size > 0
    baseStopLong = strategy.position_avg_price - atrVal * stopAtr
    trailCandidateLong = source - atrVal * trailAtr
    longTrail := na(longTrail) ? trailCandidateLong : math.max(longTrail, trailCandidateLong)
    breakevenLong = source >= strategy.position_avg_price + atrVal * beTriggerAtr ? strategy.position_avg_price : na
    longStopNoBE = math.max(baseStopLong, longTrail)
    finalLongStop = na(breakevenLong) ? longStopNoBE : math.max(longStopNoBE, breakevenLong)
    longTarget = strategy.position_avg_price + atrVal * takeAtr
    strategy.exit("Long Exit", from_entry="Long", stop=finalLongStop, limit=longTarget, comment="Risk Exit")
else
    longTrail := na

if strategy.position_size < 0
    baseStopShort = strategy.position_avg_price + atrVal * stopAtr
    trailCandidateShort = source + atrVal * trailAtr
    shortTrail := na(shortTrail) ? trailCandidateShort : math.min(shortTrail, trailCandidateShort)
    breakevenShort = source <= strategy.position_avg_price - atrVal * beTriggerAtr ? strategy.position_avg_price : na
    shortStopNoBE = math.min(baseStopShort, shortTrail)
    finalShortStop = na(breakevenShort) ? shortStopNoBE : math.min(shortStopNoBE, breakevenShort)
    shortTarget = strategy.position_avg_price - atrVal * takeAtr
    strategy.exit("Short Exit", from_entry="Short", stop=finalShortStop, limit=shortTarget, comment="Risk Exit")
else
    shortTrail := na

timeStop = strategy.position_size != 0 and not na(entryBar) and (bar_index - entryBar >= maxBarsInTrade)
if timeStop and strategy.position_size > 0
    strategy.close("Long", comment="Time Stop")
if timeStop and strategy.position_size < 0
    strategy.close("Short", comment="Time Stop")

if useBasisExit and strategy.position_size > 0 and ta.crossunder(source, basis)
    strategy.close("Long", comment="Basis Exit")
if useBasisExit and strategy.position_size < 0 and ta.crossover(source, basis)
    strategy.close("Short", comment="Basis Exit")

plot(upper, title="Upper Band", color=color.new(color.yellow, 10), linewidth=1)
plot(lower, title="Lower Band", color=color.new(color.yellow, 10), linewidth=1)
plot(basis, title="Basis", color=color.blue, linewidth=1)
plot(trendEma, title="Trend EMA", color=color.orange, linewidth=1)

plotshape(longSignal, title="Long", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny)
plotshape(shortSignal, title="Short", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny)

