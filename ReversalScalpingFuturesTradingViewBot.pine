//@version=5
strategy(
     title = "Reversal Scalping Futures Bot (Realistic)",
     shorttitle = "ReversalScalpBot",
     overlay = true,
     pyramiding = 0,
     initial_capital = 50000,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract,
     commission_value = 2.40,
     slippage = 1,
     process_orders_on_close = true,
     calc_on_order_fills = true)

// -----------------------------
// Inputs: Timing
// -----------------------------
const string groupTiming = "Timing"
useTiming15m = input.bool(true, "UseTiming15m", group = groupTiming)
useTiming30m = input.bool(true, "UseTiming30m", group = groupTiming)
useTiming90m = input.bool(false, "UseTiming90m", group = groupTiming)
timingWindowToleranceMinutes = input.int(2, "TimingWindowToleranceMinutes", minval = 0, maxval = 10, group = groupTiming)

// -----------------------------
// Inputs: Session
// -----------------------------
const string groupSession = "Session"
sessionTemplate = input.session("1800-1700", "SessionTemplate", group = groupSession)
cashOpenMode = input.string("ClockTime", "CashOpenMode", options = ["ClockTime", "SessionOffset"], group = groupSession)
cashOpenHour = input.int(9, "CashOpenHour", minval = 0, maxval = 23, group = groupSession)
cashOpenMinute = input.int(30, "CashOpenMinute", minval = 0, maxval = 59, group = groupSession)
cashOpenTimeZone = input.string("America/New_York", "CashOpenTimeZone", group = groupSession)
sessionOpenOffsetMinutes = input.int(930, "SessionOpenOffsetMinutes", minval = 0, maxval = 1440, group = groupSession)
tradeWindowMinutesAfterOpen = input.int(60, "TradeWindowMinutesAfterOpen", minval = 1, maxval = 240, group = groupSession)
maxTradesPerSession = input.int(6, "MaxTradesPerSession", minval = 1, maxval = 20, group = groupSession)
oneTradePerTimingWindow = input.bool(false, "OneTradePerTimingWindow", group = groupSession)
entryExpiryBars = input.int(3, "EntryExpiryBars", minval = 1, maxval = 20, group = groupSession)
requireOneMinuteChart = input.bool(false, "Require1MinuteChart", group = groupSession)

allowMonday = input.bool(true, "Trade Monday", group = groupSession)
allowTuesday = input.bool(true, "Trade Tuesday", group = groupSession)
allowWednesday = input.bool(true, "Trade Wednesday", group = groupSession)
allowThursday = input.bool(true, "Trade Thursday", group = groupSession)
allowFriday = input.bool(true, "Trade Friday", group = groupSession)

// -----------------------------
// Inputs: Zones
// -----------------------------
const string groupZones = "Zones"
zoneTimeframe = input.timeframe("15", "ZoneTimeframeMinutes", group = groupZones)
zoneLookbackDays = input.int(3, "ZoneLookbackDays", minval = 1, maxval = 10, group = groupZones)
pivotStrength = input.int(4, "PivotStrength", minval = 2, maxval = 20, group = groupZones)
minTouchesForZone = input.int(2, "MinTouchesForZone", minval = 1, maxval = 10, group = groupZones)
zonePaddingTicks = input.int(8, "ZonePaddingTicks", minval = 1, maxval = 50, group = groupZones)
zoneProximityTicks = input.int(8, "ZoneProximityTicks", minval = 1, maxval = 50, group = groupZones)
maxZonesToTrack = input.int(10, "MaxZonesToTrack", minval = 1, maxval = 30, group = groupZones)
usePriorDayHLC = input.bool(true, "UsePriorDayHLC", group = groupZones)
useTodayOpenLevel = input.bool(true, "UseTodayOpenLevel", group = groupZones)
useOvernightHL = input.bool(false, "UseOvernightHL", group = groupZones)
useGaps = input.bool(true, "UseGaps", group = groupZones)
minGapTicks = input.int(12, "MinGapTicks", minval = 1, maxval = 100, group = groupZones)

// -----------------------------
// Inputs: Volatility / Chop
// -----------------------------
const string groupVol = "Volatility"
useATRFilter = input.bool(true, "UseATRFilter", group = groupVol)
atrPeriod = input.int(14, "ATRPeriod", minval = 2, maxval = 100, group = groupVol)
minATR = input.float(1.0, "MinATR", minval = 0.01, group = groupVol)
useOpenRangeFilter = input.bool(true, "UseOpenRangeFilter", group = groupVol)
openRangeMinutes = input.int(10, "OpenRangeMinutes", minval = 1, maxval = 60, group = groupVol)
minOpenRangeTicks = input.int(12, "MinOpenRangeTicks", minval = 1, maxval = 200, group = groupVol)
useChopRatioFilter = input.bool(true, "UseChopRatioFilter", group = groupVol)
chopLookbackBars = input.int(20, "ChopLookbackBars", minval = 5, maxval = 200, group = groupVol)
maxChopRatio = input.float(3.2, "MaxChopRatio", minval = 1.0, maxval = 20.0, group = groupVol)

// -----------------------------
// Inputs: Trend / Overextension
// -----------------------------
const string groupTrend = "Trend"
requireTrendShift = input.bool(true, "RequireTrendShift", group = groupTrend)
structureLookbackBars = input.int(30, "StructureLookbackBars", minval = 10, maxval = 200, group = groupTrend)
useOverextensionRule = input.bool(false, "UseOverextensionRule", group = groupTrend)
overextensionATRMultiplier = input.float(1.5, "OverextensionATRMultiplier", minval = 0.5, maxval = 10.0, group = groupTrend)

// -----------------------------
// Inputs: Patterns
// -----------------------------
const string groupPatterns = "Patterns"
enableDoubleBottom = input.bool(true, "EnableDoubleBottom", group = groupPatterns)
doubleBottomToleranceTicks = input.int(4, "DoubleBottomToleranceTicks", minval = 1, maxval = 20, group = groupPatterns)
enableHigherLowBreak = input.bool(true, "EnableHigherLowBreak", group = groupPatterns)
enableHeadAndShoulders = input.bool(true, "EnableHeadAndShoulders", group = groupPatterns)
enableEngulfing = input.bool(true, "EnableEngulfing", group = groupPatterns)
enableThreeLineStrike = input.bool(false, "EnableThreeLineStrike", group = groupPatterns)
requireEngulfingOrStrongClose = input.bool(false, "RequireEngulfingOrStrongClose", group = groupPatterns)
minReversalCandleBodyRatio = input.float(0.6, "MinReversalCandleBodyRatio", minval = 0.1, maxval = 1.0, group = groupPatterns)
entryOffsetTicks = input.int(1, "EntryOffsetTicks", minval = 0, maxval = 10, group = groupPatterns)

// -----------------------------
// Inputs: Stops / Targets
// -----------------------------
const string groupStops = "StopsTargets"
stopMethod = input.string("SwingExtreme", "StopMethod", options = ["SwingExtreme", "SignalBar", "FixedTicks"], group = groupStops)
stopBufferTicks = input.int(2, "StopBufferTicks", minval = 0, maxval = 20, group = groupStops)
fixedStopTicks = input.int(20, "FixedStopTicks", minval = 1, maxval = 100, group = groupStops)
maxStopTicks = input.int(40, "MaxStopTicks", minval = 1, maxval = 200, group = groupStops)
targetR = input.float(0.9, "TargetR", minval = 0.3, maxval = 10.0, group = groupStops)
useZoneTargets = input.bool(false, "UseZoneTargets", group = groupStops)

// -----------------------------
// Inputs: Management
// -----------------------------
const string groupMgmt = "Management"
moveToBreakEvenEnabled = input.bool(true, "MoveToBreakEvenEnabled", group = groupMgmt)
breakEvenTriggerR = input.float(0.55, "BreakEvenTriggerR", minval = 0.2, maxval = 10.0, group = groupMgmt)
breakEvenPlusTicks = input.int(0, "BreakEvenPlusTicks", minval = 0, maxval = 10, group = groupMgmt)
scaleOutEnabled = input.bool(false, "ScaleOutEnabled", group = groupMgmt)
scaleOutPercent = input.int(50, "ScaleOutPercent", minval = 1, maxval = 99, group = groupMgmt)
scaleOutAtR = input.float(2.0, "ScaleOutAtR", minval = 0.5, maxval = 10.0, group = groupMgmt)
trailEnabled = input.bool(false, "TrailEnabled", group = groupMgmt)
trailMethod = input.string("Swing", "TrailMethod", options = ["Swing", "FixedTicks"], group = groupMgmt)
trailTicks = input.int(8, "TrailTicks", minval = 1, maxval = 100, group = groupMgmt)
maxHoldMinutes = input.int(0, "MaxHoldMinutes", minval = 0, maxval = 240, group = groupMgmt)

// -----------------------------
// Inputs: Risk / Sizing
// -----------------------------
const string groupRisk = "Risk"
useFixedDollarRisk = input.bool(true, "UseFixedDollarRisk", group = groupRisk)
riskPerTradeDollars = input.float(300.0, "RiskPerTradeDollars", minval = 1, group = groupRisk)
minContracts = input.int(1, "MinContracts", minval = 1, maxval = 100, group = groupRisk)
maxContracts = input.int(5, "MaxContracts", minval = 1, maxval = 100, group = groupRisk)
baseContracts = input.int(1, "BaseContractsWhenNotRiskSized", minval = 1, maxval = 100, group = groupRisk)
useSymbolPointValue = input.bool(true, "UseSymbolPointValue", group = groupRisk)
pointValueOverride = input.float(50.0, "PointValueOverride", minval = 0.01, group = groupRisk)

// -----------------------------
// Inputs: Execution mode (trade frequency controls)
// -----------------------------
const string groupExec = "Execution"
enforceTradeWindow = input.bool(false, "EnforceTradeWindowAfterOpen", group = groupExec)
requireTimingWindow = input.bool(false, "RequireTimingWindow", group = groupExec)
requireZoneGate = input.bool(false, "RequireZoneGate", group = groupExec)
requireTrendGate = input.bool(false, "RequireTrendGate", group = groupExec)
requireVolatilityGate = input.bool(false, "RequireVolatilityGate", group = groupExec)
enableFallbackPattern = input.bool(false, "EnableFallbackPattern", group = groupExec)
enforceMaxStopFilter = input.bool(false, "EnforceMaxStopFilter", group = groupExec)
forceMinQtyWhenRiskTooSmall = input.bool(true, "ForceMinQtyWhenRiskTooSmall", group = groupExec)
minBarsBetweenEntries = input.int(4, "MinBarsBetweenEntries", minval = 0, maxval = 100, group = groupExec)
showSignalMarkers = input.bool(true, "ShowSignalMarkers", group = groupExec)
showRawPatternMarkers = input.bool(false, "ShowRawPatternMarkers", group = groupExec)
showPendingEntryLine = input.bool(true, "ShowPendingEntryLine", group = groupExec)
showSetupMarkers = input.bool(true, "ShowSetupMarkers", group = groupExec)
entryExecutionMode = input.string("Market", "EntryExecutionMode", options = ["Market", "StopMarket"], group = groupExec)
highWinScalpMode = input.bool(true, "HighWinScalpMode", group = groupExec)
highWinTargetR = input.float(0.60, "HighWinTargetR", minval = 0.3, maxval = 3.0, group = groupExec)
maxBarsInTradeScalp = input.int(16, "MaxBarsInTradeScalp", minval = 1, maxval = 300, group = groupExec)
fastExitOnOppositeCandle = input.bool(true, "FastExitOnOppositeCandle", group = groupExec)
autoRelaxIfNoTrades = input.bool(true, "AutoRelaxIfNoTrades", group = groupExec)
autoRelaxMinutes = input.int(45, "AutoRelaxAfterMinutes", minval = 1, maxval = 240, group = groupExec)
autoRelaxDisablePrecision = input.bool(true, "AutoRelaxDisablePrecision", group = groupExec)

// -----------------------------
// Inputs: Precision profile
// -----------------------------
const string groupPrecision = "Precision"
precisionMode = input.bool(true, "PrecisionMode", group = groupPrecision)
precisionMinScore = input.int(5, "PrecisionMinScore", minval = 1, maxval = 10, group = groupPrecision)
useEMATrendFilter = input.bool(true, "UseEMATrendFilter", group = groupPrecision)
emaFastLength = input.int(20, "EMAFastLength", minval = 2, maxval = 200, group = groupPrecision)
emaSlowLength = input.int(50, "EMASlowLength", minval = 3, maxval = 300, group = groupPrecision)
useHTFTrendFilter = input.bool(true, "UseHTFTrendFilter", group = groupPrecision)
htfFastLength = input.int(34, "HTFFastLength", minval = 2, maxval = 300, group = groupPrecision)
htfSlowLength = input.int(89, "HTFSlowLength", minval = 3, maxval = 400, group = groupPrecision)
useRSIFilterPrecision = input.bool(true, "UseRSIFilter", group = groupPrecision)
rsiPeriodPrecision = input.int(14, "RSIPeriod", minval = 2, maxval = 100, group = groupPrecision)
longRSIMin = input.float(52.0, "LongRSIMin", minval = 1, maxval = 99, group = groupPrecision)
shortRSIMax = input.float(48.0, "ShortRSIMax", minval = 1, maxval = 99, group = groupPrecision)
useVWAPFilterPrecision = input.bool(true, "UseVWAPFilter", group = groupPrecision)
useAdxFilterPrecision = input.bool(true, "UseADXFilter", group = groupPrecision)
adxPeriodPrecision = input.int(14, "ADXPeriod", minval = 2, maxval = 100, group = groupPrecision)
minAdxPrecision = input.float(18.0, "MinADX", minval = 1.0, maxval = 100.0, group = groupPrecision)
useContinuationPattern = input.bool(true, "UseContinuationPattern", group = groupPrecision)
continuationPullbackBars = input.int(2, "ContinuationPullbackBars", minval = 1, maxval = 10, group = groupPrecision)
minPatternScore = input.int(2, "MinPatternScore", minval = 1, maxval = 6, group = groupPrecision)

// -----------------------------
// Constants / state
// -----------------------------
int BIAS_SUPPORT = 1
int BIAS_RESISTANCE = -1
int BIAS_NEUTRAL = 0

var zoneLow = array.new_float()
var zoneHigh = array.new_float()
var zoneTouches = array.new_int()
var zoneBias = array.new_int()
var zoneSpecial = array.new_bool()
var zoneTime = array.new_int()

var bool sessionInitialized = false
var bool cashOpenTriggered = false
var int sessionStartTs = na
var int cashOpenTs = na

var float sessionHigh = na
var float sessionLow = na
var float sessionClose = na
var float priorSessionHigh = na
var float priorSessionLow = na
var float priorSessionClose = na
var bool hasPriorSession = false

var float overnightHigh = na
var float overnightLow = na
var bool hasOvernightData = false

var float openRangeHigh = na
var float openRangeLow = na

var int tradesThisSessionWindow = 0
var bool usedTiming15 = false
var bool usedTiming30 = false
var bool usedTiming90 = false

var bool pendingLong = false
var bool pendingShort = false
var int pendingBar = na
var int pendingTimingBucket = 0
var float plannedStop = na
var float plannedTarget = na

var float activeStop = na
var float activeTarget = na
var float initialRiskPoints = na
var bool breakEvenMoved = false
var bool scaleOutDone = false
var int positionEntryTs = na
var int lastFillBar = na
var float plannedEntry = na
var int positionEntryBar = na

// -----------------------------
// Helpers
// -----------------------------
round_to_tick(float px) =>
    math.round(px / syminfo.mintick) * syminfo.mintick

is_allowed_day() =>
    int d = dayofweek
    (d == dayofweek.monday and allowMonday) or
     (d == dayofweek.tuesday and allowTuesday) or
     (d == dayofweek.wednesday and allowWednesday) or
     (d == dayofweek.thursday and allowThursday) or
     (d == dayofweek.friday and allowFriday)

is_one_minute_ok() =>
    not requireOneMinuteChart or (timeframe.isminutes and timeframe.multiplier == 1)

strong_body(int barsAgo) =>
    float rng = high[barsAgo] - low[barsAgo]
    rng > 0 ? (math.abs(close[barsAgo] - open[barsAgo]) / rng) >= minReversalCandleBodyRatio : false

remove_zone(int idx) =>
    array.remove(zoneLow, idx)
    array.remove(zoneHigh, idx)
    array.remove(zoneTouches, idx)
    array.remove(zoneBias, idx)
    array.remove(zoneSpecial, idx)
    array.remove(zoneTime, idx)

trim_zone_count() =>
    int safety = 0
    while array.size(zoneLow) > maxZonesToTrack and safety < 100
        int candidate = na
        int candidateTouches = 1000000
        int candidateTs = int(9e15)
        for i = 0 to array.size(zoneLow) - 1
            bool isSp = array.get(zoneSpecial, i)
            if not isSp
                int t = array.get(zoneTouches, i)
                int ts = array.get(zoneTime, i)
                bool better = t < candidateTouches or (t == candidateTouches and ts < candidateTs)
                if na(candidate) or better
                    candidate := i
                    candidateTouches := t
                    candidateTs := ts
        if na(candidate)
            for i = 0 to array.size(zoneLow) - 1
                int t = array.get(zoneTouches, i)
                int ts = array.get(zoneTime, i)
                bool better = t < candidateTouches or (t == candidateTouches and ts < candidateTs)
                if na(candidate) or better
                    candidate := i
                    candidateTouches := t
                    candidateTs := ts
        if not na(candidate)
            remove_zone(candidate)
        safety += 1

add_or_merge_zone(float price, int bias, bool isSpecial, int ts) =>
    if not na(price)
        float padding = zonePaddingTicks * syminfo.mintick
        int matchIdx = na
        if array.size(zoneLow) > 0
            for i = 0 to array.size(zoneLow) - 1
                float center = (array.get(zoneLow, i) + array.get(zoneHigh, i)) * 0.5
                if math.abs(center - price) <= padding
                    matchIdx := i
                    break

        if na(matchIdx)
            array.push(zoneLow, price - padding)
            array.push(zoneHigh, price + padding)
            array.push(zoneTouches, isSpecial ? math.max(1, minTouchesForZone) : 1)
            array.push(zoneBias, bias)
            array.push(zoneSpecial, isSpecial)
            array.push(zoneTime, ts)
        else
            float newLow = math.min(array.get(zoneLow, matchIdx), price - padding)
            float newHigh = math.max(array.get(zoneHigh, matchIdx), price + padding)
            int oldTouches = array.get(zoneTouches, matchIdx)
            int newTouches = isSpecial ? math.max(oldTouches, minTouchesForZone) : oldTouches + 1
            int oldBias = array.get(zoneBias, matchIdx)
            int mergedBias = oldBias == bias ? oldBias : BIAS_NEUTRAL
            bool mergedSpecial = array.get(zoneSpecial, matchIdx) or isSpecial

            array.set(zoneLow, matchIdx, newLow)
            array.set(zoneHigh, matchIdx, newHigh)
            array.set(zoneTouches, matchIdx, newTouches)
            array.set(zoneBias, matchIdx, mergedBias)
            array.set(zoneSpecial, matchIdx, mergedSpecial)
            array.set(zoneTime, matchIdx, ts)

        trim_zone_count()

prune_old_zones(int referenceTs) =>
    int cutoff = referenceTs - zoneLookbackDays * 86400000
    if array.size(zoneLow) > 0
        int i = array.size(zoneLow) - 1
        while i >= 0
            bool isSp = array.get(zoneSpecial, i)
            int zt = array.get(zoneTime, i)
            if not isSp and zt < cutoff
                remove_zone(i)
            i -= 1
    trim_zone_count()

zone_active(int i) =>
    array.get(zoneSpecial, i) or array.get(zoneTouches, i) >= minTouchesForZone

distance_to_zone_ticks(float px, float zLow, float zHigh) =>
    px >= zLow and px <= zHigh ? 0.0 : (px < zLow ? (zLow - px) / syminfo.mintick : (px - zHigh) / syminfo.mintick)

nearest_zone(bool forLong, float px) =>
    float nearestDist = 1e10
    int nearestIdx = na
    if array.size(zoneLow) > 0
        for i = 0 to array.size(zoneLow) - 1
            if zone_active(i)
                int b = array.get(zoneBias, i)
                bool biasOk = forLong ? b != BIAS_RESISTANCE : b != BIAS_SUPPORT
                if biasOk
                    float d = distance_to_zone_ticks(px, array.get(zoneLow, i), array.get(zoneHigh, i))
                    if d < nearestDist
                        nearestDist := d
                        nearestIdx := i
    bool ok = not na(nearestIdx) and nearestDist <= zoneProximityTicks
    [ok, nearestDist, nz(nearestIdx, -1)]

find_zone_target(bool forLong, float entryPx) =>
    float best = na
    if array.size(zoneLow) > 0
        for i = 0 to array.size(zoneLow) - 1
            if zone_active(i)
                int b = array.get(zoneBias, i)
                if forLong
                    if b != BIAS_SUPPORT
                        float level = array.get(zoneLow, i)
                        if level > entryPx + syminfo.mintick
                            best := na(best) ? level : math.min(best, level)
                else
                    if b != BIAS_RESISTANCE
                        float level = array.get(zoneHigh, i)
                        if level < entryPx - syminfo.mintick
                            best := na(best) ? level : math.max(best, level)
    best

active_timing_bucket(float elapsedMinutes) =>
    int bucket = 0
    float bestDelta = 1e10
    if useTiming15m
        float d = math.abs(elapsedMinutes - 15.0)
        if d <= timingWindowToleranceMinutes and d < bestDelta
            bucket := 15
            bestDelta := d
    if useTiming30m
        float d = math.abs(elapsedMinutes - 30.0)
        if d <= timingWindowToleranceMinutes and d < bestDelta
            bucket := 30
            bestDelta := d
    if useTiming90m
        float d = math.abs(elapsedMinutes - 90.0)
        if d <= timingWindowToleranceMinutes and d < bestDelta
            bucket := 90
            bestDelta := d
    bucket

timing_bucket_used(int bucket) =>
    bucket == 15 ? usedTiming15 : bucket == 30 ? usedTiming30 : bucket == 90 ? usedTiming90 : false

calc_contracts(float entryPx, float stopPx, float pointValue) =>
    int maxC = math.max(1, maxContracts)
    int minC = math.max(1, minContracts)
    if not useFixedDollarRisk
        int q = math.max(minC, baseContracts)
        math.min(maxC, q)
    else
        float riskPerContract = math.abs(entryPx - stopPx) * pointValue
        if riskPerContract <= 0
            0
        else
            int c = int(math.floor(riskPerTradeDollars / riskPerContract))
            c := math.min(maxC, c)
            c < minC ? (forceMinQtyWhenRiskTooSmall ? minC : 0) : c

build_entry_message(string side, int qty, float entryPx, float stopPx, float targetPx, int bucket) =>
    "{" +
     "\"event\":\"entry\"," +
     "\"bot\":\"ReversalScalpTV\"," +
     "\"ticker\":\"" + syminfo.ticker + "\"," +
     "\"side\":\"" + side + "\"," +
     "\"qty\":" + str.tostring(qty) + "," +
     "\"entry\":" + str.tostring(entryPx) + "," +
     "\"stop\":" + str.tostring(stopPx) + "," +
     "\"target\":" + str.tostring(targetPx) + "," +
     "\"timing\":" + str.tostring(bucket) +
     "}"

build_exit_message(string side, string reason) =>
    "{" +
     "\"event\":\"exit\"," +
     "\"bot\":\"ReversalScalpTV\"," +
     "\"ticker\":\"" + syminfo.ticker + "\"," +
     "\"side\":\"" + side + "\"," +
     "\"reason\":\"" + reason + "\"" +
     "}"

// -----------------------------
// Session tracking
// -----------------------------
bool inTemplateSession = not na(time(timeframe.period, sessionTemplate))
bool newTemplateSession = inTemplateSession and not inTemplateSession[1]

if newTemplateSession
    if sessionInitialized
        priorSessionHigh := sessionHigh
        priorSessionLow := sessionLow
        priorSessionClose := sessionClose
        hasPriorSession := not na(priorSessionHigh) and not na(priorSessionLow) and not na(priorSessionClose)

    sessionInitialized := true
    sessionStartTs := time
    cashOpenTs := cashOpenMode == "SessionOffset" ? (sessionStartTs + sessionOpenOffsetMinutes * 60000) : na
    cashOpenTriggered := false

    sessionHigh := high
    sessionLow := low
    sessionClose := close

    overnightHigh := na
    overnightLow := na
    hasOvernightData := false

    strategy.cancel("L")
    strategy.cancel("S")
    pendingLong := false
    pendingShort := false
    pendingTimingBucket := 0
    pendingBar := na
    plannedEntry := na

if inTemplateSession and not newTemplateSession
    sessionHigh := na(sessionHigh) ? high : math.max(sessionHigh, high)
    sessionLow := na(sessionLow) ? low : math.min(sessionLow, low)
    sessionClose := close

if inTemplateSession and not cashOpenTriggered
    int openMinuteOfDay = cashOpenHour * 60 + cashOpenMinute
    int currentMinuteOfDay = hour(time, cashOpenTimeZone) * 60 + minute(time, cashOpenTimeZone)
    int prevMinuteOfDay = na(time[1]) ? currentMinuteOfDay : (hour(time[1], cashOpenTimeZone) * 60 + minute(time[1], cashOpenTimeZone))
    bool newClockDay = not na(time[1]) and (
         year(time, cashOpenTimeZone) != year(time[1], cashOpenTimeZone) or
         month(time, cashOpenTimeZone) != month(time[1], cashOpenTimeZone) or
         dayofmonth(time, cashOpenTimeZone) != dayofmonth(time[1], cashOpenTimeZone))

    bool clockOpenNow = currentMinuteOfDay >= openMinuteOfDay and (prevMinuteOfDay < openMinuteOfDay or newClockDay)
    bool offsetOpenNow = not na(cashOpenTs) and time >= cashOpenTs
    bool shouldTriggerOpen = cashOpenMode == "ClockTime" ? clockOpenNow : offsetOpenNow

    if not shouldTriggerOpen
        overnightHigh := na(overnightHigh) ? high : math.max(overnightHigh, high)
        overnightLow := na(overnightLow) ? low : math.min(overnightLow, low)
        hasOvernightData := true

    if shouldTriggerOpen
        cashOpenTs := time
        cashOpenTriggered := true
        tradesThisSessionWindow := 0
        usedTiming15 := false
        usedTiming30 := false
        usedTiming90 := false
        openRangeHigh := high
        openRangeLow := low

        if useTodayOpenLevel
            add_or_merge_zone(open, BIAS_NEUTRAL, true, time)

        if usePriorDayHLC and hasPriorSession
            add_or_merge_zone(priorSessionHigh, BIAS_RESISTANCE, true, time)
            add_or_merge_zone(priorSessionLow, BIAS_SUPPORT, true, time)
            add_or_merge_zone(priorSessionClose, BIAS_NEUTRAL, true, time)

        if useOvernightHL and hasOvernightData
            add_or_merge_zone(overnightHigh, BIAS_RESISTANCE, true, time)
            add_or_merge_zone(overnightLow, BIAS_SUPPORT, true, time)

        if useGaps and hasPriorSession
            float gapTicks = math.abs(open - priorSessionClose) / syminfo.mintick
            if gapTicks >= minGapTicks
                add_or_merge_zone(priorSessionClose, BIAS_NEUTRAL, true, time)
                add_or_merge_zone(open, BIAS_NEUTRAL, true, time)

        prune_old_zones(time)

float minutesFromOpen = cashOpenTriggered and not na(cashOpenTs) ? (time - cashOpenTs) / 60000.0 : na
bool withinTradeWindow = cashOpenTriggered and minutesFromOpen >= 0 and minutesFromOpen <= tradeWindowMinutesAfterOpen

if cashOpenTriggered and useOpenRangeFilter and not na(minutesFromOpen) and minutesFromOpen <= openRangeMinutes
    openRangeHigh := na(openRangeHigh) ? high : math.max(openRangeHigh, high)
    openRangeLow := na(openRangeLow) ? low : math.min(openRangeLow, low)

// -----------------------------
// Zone updates from higher timeframe pivots
// -----------------------------
float htfPivotHigh = request.security(syminfo.tickerid, zoneTimeframe, ta.pivothigh(high, pivotStrength, pivotStrength), lookahead = barmerge.lookahead_off)
float htfPivotLow = request.security(syminfo.tickerid, zoneTimeframe, ta.pivotlow(low, pivotStrength, pivotStrength), lookahead = barmerge.lookahead_off)
bool newZoneTfBar = ta.change(time(zoneTimeframe)) != 0

if newZoneTfBar
    if not na(htfPivotHigh)
        add_or_merge_zone(htfPivotHigh, BIAS_RESISTANCE, false, time)
    if not na(htfPivotLow)
        add_or_merge_zone(htfPivotLow, BIAS_SUPPORT, false, time)
    prune_old_zones(time)

// -----------------------------
// Position/Order transitions
// -----------------------------
bool newLongFill = strategy.position_size > 0 and strategy.position_size[1] <= 0
bool newShortFill = strategy.position_size < 0 and strategy.position_size[1] >= 0
bool justFlat = strategy.position_size == 0 and strategy.position_size[1] != 0

if newLongFill or newShortFill
    tradesThisSessionWindow += 1
    if pendingTimingBucket == 15
        usedTiming15 := true
    else if pendingTimingBucket == 30
        usedTiming30 := true
    else if pendingTimingBucket == 90
        usedTiming90 := true
    pendingTimingBucket := 0
    pendingLong := false
    pendingShort := false
    pendingBar := na
    breakEvenMoved := false
    scaleOutDone := false
    positionEntryTs := time
    positionEntryBar := bar_index

    activeStop := plannedStop
    activeTarget := plannedTarget
    initialRiskPoints := math.max(syminfo.mintick, math.abs(strategy.position_avg_price - activeStop))
    lastFillBar := bar_index

if justFlat
    activeStop := na
    activeTarget := na
    initialRiskPoints := na
    breakEvenMoved := false
    scaleOutDone := false
    positionEntryTs := na
    positionEntryBar := na

bool pendingOrderExists = pendingLong or pendingShort
bool pendingExpired = pendingOrderExists and not na(pendingBar) and (bar_index - pendingBar >= entryExpiryBars)
bool stopModeNow = entryExecutionMode == "StopMarket"
float effectiveTargetR = highWinScalpMode ? math.min(targetR, highWinTargetR) : targetR
float effectiveBreakEvenR = highWinScalpMode ? math.min(breakEvenTriggerR, math.max(0.25, effectiveTargetR * 0.7)) : breakEvenTriggerR
int barsInTrade = not na(positionEntryBar) ? (bar_index - positionEntryBar) : 0

if pendingLong and strategy.position_size <= 0 and (not withinTradeWindow or pendingExpired)
    strategy.cancel("L")
    pendingLong := false
    pendingTimingBucket := 0
    pendingBar := na
    plannedEntry := na

if pendingShort and strategy.position_size >= 0 and (not withinTradeWindow or pendingExpired)
    strategy.cancel("S")
    pendingShort := false
    pendingTimingBucket := 0
    pendingBar := na
    plannedEntry := na

// Safety reset for market-entry mode if a timing bucket remains set without a fill.
if not stopModeNow and strategy.position_size == 0 and not pendingOrderExists and pendingTimingBucket != 0 and not na(pendingBar) and (bar_index - pendingBar >= 1)
    pendingTimingBucket := 0
    pendingBar := na

int trailLookback = math.max(5, math.min(20, int(math.floor(structureLookbackBars * 0.5))))
float trailBaseLow = ta.lowest(low, trailLookback)
float trailBaseHigh = ta.highest(high, trailLookback)

// -----------------------------
// Manage open trade (BE, scale, trail, max hold)
// -----------------------------
if strategy.position_size > 0
    if na(initialRiskPoints) or initialRiskPoints <= 0
        initialRiskPoints := math.max(syminfo.mintick, math.abs(strategy.position_avg_price - activeStop))

    float currentR = (close - strategy.position_avg_price) / initialRiskPoints

    if highWinScalpMode and barsInTrade >= maxBarsInTradeScalp
        strategy.close("L", comment = "SCALP_TIME_LONG", alert_message = build_exit_message("long", "scalp_time"))

    if highWinScalpMode and fastExitOnOppositeCandle and close < open and close < low[1]
        strategy.close("L", comment = "SCALP_REV_LONG", alert_message = build_exit_message("long", "scalp_reversal"))

    if maxHoldMinutes > 0 and not na(positionEntryTs) and time >= positionEntryTs + maxHoldMinutes * 60000
        strategy.close("L", comment = "TIME_EXIT_LONG", alert_message = build_exit_message("long", "time"))

    if moveToBreakEvenEnabled and not breakEvenMoved and currentR >= effectiveBreakEvenR
        float beStop = strategy.position_avg_price + breakEvenPlusTicks * syminfo.mintick
        beStop := math.min(beStop, close - syminfo.mintick)
        activeStop := na(activeStop) ? beStop : math.max(activeStop, beStop)
        breakEvenMoved := true

    if scaleOutEnabled and not scaleOutDone and currentR >= scaleOutAtR and math.abs(strategy.position_size) > 1
        strategy.close("L", qty_percent = scaleOutPercent, comment = "SCALE_OUT_LONG", alert_message = build_exit_message("long", "scale_out"))
        scaleOutDone := true

    if trailEnabled
        float candidateTrail = trailMethod == "FixedTicks" ? (close - trailTicks * syminfo.mintick) : (trailBaseLow - trailTicks * syminfo.mintick)
        candidateTrail := math.min(candidateTrail, close - syminfo.mintick)
        activeStop := na(activeStop) ? candidateTrail : math.max(activeStop, candidateTrail)

    strategy.exit("L-EXIT", "L", stop = activeStop, limit = activeTarget, alert_message = build_exit_message("long", "stop_or_target"))

if strategy.position_size < 0
    if na(initialRiskPoints) or initialRiskPoints <= 0
        initialRiskPoints := math.max(syminfo.mintick, math.abs(strategy.position_avg_price - activeStop))

    float currentR = (strategy.position_avg_price - close) / initialRiskPoints

    if highWinScalpMode and barsInTrade >= maxBarsInTradeScalp
        strategy.close("S", comment = "SCALP_TIME_SHORT", alert_message = build_exit_message("short", "scalp_time"))

    if highWinScalpMode and fastExitOnOppositeCandle and close > open and close > high[1]
        strategy.close("S", comment = "SCALP_REV_SHORT", alert_message = build_exit_message("short", "scalp_reversal"))

    if maxHoldMinutes > 0 and not na(positionEntryTs) and time >= positionEntryTs + maxHoldMinutes * 60000
        strategy.close("S", comment = "TIME_EXIT_SHORT", alert_message = build_exit_message("short", "time"))

    if moveToBreakEvenEnabled and not breakEvenMoved and currentR >= effectiveBreakEvenR
        float beStop = strategy.position_avg_price - breakEvenPlusTicks * syminfo.mintick
        beStop := math.max(beStop, close + syminfo.mintick)
        activeStop := na(activeStop) ? beStop : math.min(activeStop, beStop)
        breakEvenMoved := true

    if scaleOutEnabled and not scaleOutDone and currentR >= scaleOutAtR and math.abs(strategy.position_size) > 1
        strategy.close("S", qty_percent = scaleOutPercent, comment = "SCALE_OUT_SHORT", alert_message = build_exit_message("short", "scale_out"))
        scaleOutDone := true

    if trailEnabled
        float candidateTrail = trailMethod == "FixedTicks" ? (close + trailTicks * syminfo.mintick) : (trailBaseHigh + trailTicks * syminfo.mintick)
        candidateTrail := math.max(candidateTrail, close + syminfo.mintick)
        activeStop := na(activeStop) ? candidateTrail : math.min(activeStop, candidateTrail)

    strategy.exit("S-EXIT", "S", stop = activeStop, limit = activeTarget, alert_message = build_exit_message("short", "stop_or_target"))

// -----------------------------
// Entry logic
// -----------------------------
int minimumBars = math.max(structureLookbackBars + 5, math.max(chopLookbackBars + 5, atrPeriod + 5))
bool hasEnoughBars = bar_index >= minimumBars
bool timeFrameOk = is_one_minute_ok()
bool dayOk = is_allowed_day()

float atrNow = ta.atr(atrPeriod)
bool atrOK = not useATRFilter or (bar_index >= atrPeriod + 1 and atrNow >= minATR)

bool openRangeOK = true
if useOpenRangeFilter
    float openRangeTicks = na(openRangeHigh) or na(openRangeLow) ? 0.0 : (openRangeHigh - openRangeLow) / syminfo.mintick
    openRangeOK := not na(minutesFromOpen) and minutesFromOpen >= openRangeMinutes and openRangeTicks >= minOpenRangeTicks

float chopHigh = ta.highest(high, chopLookbackBars)
float chopLow = ta.lowest(low, chopLookbackBars)
bool chopOK = true
if useChopRatioFilter
    float sumRanges = 0.0
    for i = 0 to chopLookbackBars - 1
        sumRanges += math.max(syminfo.mintick, high[i] - low[i])
    float netRange = chopHigh - chopLow
    float chopRatio = netRange > syminfo.mintick * 0.5 ? (sumRanges / netRange) : 1e10
    chopOK := bar_index >= chopLookbackBars + 1 and chopRatio <= maxChopRatio

bool volatilityOK = atrOK and openRangeOK and chopOK

int timingBucket = not na(minutesFromOpen) ? active_timing_bucket(minutesFromOpen) : 0
bool timingOK = timingBucket != 0
bool timingAvailable = not oneTradePerTimingWindow or not timing_bucket_used(timingBucket)
bool tradeSlotsOK = tradesThisSessionWindow < maxTradesPerSession
bool spacingOK = na(lastFillBar) or (bar_index - lastFillBar >= minBarsBetweenEntries)
bool relaxModeActive = autoRelaxIfNoTrades and cashOpenTriggered and tradesThisSessionWindow == 0 and not na(minutesFromOpen) and minutesFromOpen >= autoRelaxMinutes
bool effectiveEnforceWindow = enforceTradeWindow and not relaxModeActive
bool effectiveRequireTiming = requireTimingWindow and not relaxModeActive
bool effectiveRequireZone = requireZoneGate and not relaxModeActive
bool effectiveRequireTrend = requireTrendGate and not relaxModeActive
bool effectiveRequireVolatility = requireVolatilityGate and not relaxModeActive
bool effectivePrecisionMode = precisionMode and not (relaxModeActive and autoRelaxDisablePrecision)
bool windowGateOK = effectiveEnforceWindow ? withinTradeWindow : true
bool timingGateOK = effectiveRequireTiming ? (timingOK and timingAvailable) : true
bool volatilityGateOK = effectiveRequireVolatility ? volatilityOK : true

float emaFast = ta.ema(close, emaFastLength)
float emaSlow = ta.ema(close, emaSlowLength)
float htfEmaFast = request.security(syminfo.tickerid, zoneTimeframe, ta.ema(close, htfFastLength), lookahead = barmerge.lookahead_off)
float htfEmaSlow = request.security(syminfo.tickerid, zoneTimeframe, ta.ema(close, htfSlowLength), lookahead = barmerge.lookahead_off)
float rsiPrecision = ta.rsi(close, rsiPeriodPrecision)
float vwapNow = ta.vwap(hlc3)
[diPlus, diMinus, adxNow] = ta.dmi(adxPeriodPrecision, adxPeriodPrecision)
int continuationLookback = math.max(1, continuationPullbackBars)
float continuationLow = ta.lowest(low, continuationLookback)
float continuationHigh = ta.highest(high, continuationLookback)
int swingLookback = math.max(6, math.min(30, structureLookbackBars))
float swingBaseLow = ta.lowest(low, swingLookback)
float swingBaseHigh = ta.highest(high, swingLookback)

bool emaLongOk = not useEMATrendFilter or (close > emaFast and emaFast > emaSlow)
bool emaShortOk = not useEMATrendFilter or (close < emaFast and emaFast < emaSlow)
bool htfLongOk = not useHTFTrendFilter or (close > htfEmaFast and htfEmaFast > htfEmaSlow)
bool htfShortOk = not useHTFTrendFilter or (close < htfEmaFast and htfEmaFast < htfEmaSlow)
bool rsiLongOk = not useRSIFilterPrecision or rsiPrecision >= longRSIMin
bool rsiShortOk = not useRSIFilterPrecision or rsiPrecision <= shortRSIMax
bool vwapLongOk = not useVWAPFilterPrecision or na(vwapNow) or close >= vwapNow
bool vwapShortOk = not useVWAPFilterPrecision or na(vwapNow) or close <= vwapNow
bool adxOk = not useAdxFilterPrecision or adxNow >= minAdxPrecision

float pl = ta.pivotlow(low, 2, 2)
float ph = ta.pivothigh(high, 2, 2)

float recentPivotLow = ta.valuewhen(not na(pl), pl, 0)
float prevPivotLow = ta.valuewhen(not na(pl), pl, 1)
float recentPivotHigh = ta.valuewhen(not na(ph), ph, 0)
float prevPivotHigh = ta.valuewhen(not na(ph), ph, 1)

bool hasTwoPivotLows = not na(recentPivotLow) and not na(prevPivotLow)
bool hasTwoPivotHighs = not na(recentPivotHigh) and not na(prevPivotHigh)

bool downContext = bar_index > structureLookbackBars and close < close[structureLookbackBars]
bool upContext = bar_index > structureLookbackBars and close > close[structureLookbackBars]

bool overextendedLong = not useOverextensionRule or ((ta.highest(high, structureLookbackBars) - low) >= overextensionATRMultiplier * atrNow)
bool overextendedShort = not useOverextensionRule or ((high - ta.lowest(low, structureLookbackBars)) >= overextensionATRMultiplier * atrNow)

bool bullishShift = hasTwoPivotLows and not na(recentPivotHigh) ? (recentPivotLow > prevPivotLow and close > recentPivotHigh) : (close > close[1] and close[1] > close[2])
bool bearishShift = hasTwoPivotHighs and not na(recentPivotLow) ? (recentPivotHigh < prevPivotHigh and close < recentPivotLow) : (close < close[1] and close[1] < close[2])

bool longTrendOK = downContext and overextendedLong and (not requireTrendShift or bullishShift)
bool shortTrendOK = upContext and overextendedShort and (not requireTrendShift or bearishShift)

[longZoneOK, longDistTicks, longZoneIdx] = nearest_zone(true, close)
[shortZoneOK, shortDistTicks, shortZoneIdx] = nearest_zone(false, close)

float pointValue = useSymbolPointValue ? syminfo.pointvalue : pointValueOverride

bool visLongSetup = false
bool visShortSetup = false
bool visLongOrderSent = false
bool visShortOrderSent = false
bool useStopEntryMode = entryExecutionMode == "StopMarket"

bool canEvaluateEntry = strategy.position_size == 0 and not pendingOrderExists and pendingTimingBucket == 0 and windowGateOK and hasEnoughBars and timeFrameOk and dayOk and tradeSlotsOK and spacingOK and timingGateOK and volatilityGateOK

if canEvaluateEntry
    // ---- Long pattern stack ----
    bool longSignal = false
    bool longEngulfingSignal = false
    float longTrigger = na
    float longAnchor = na

    bool dblBottom = hasTwoPivotLows and math.abs(recentPivotLow - prevPivotLow) <= doubleBottomToleranceTicks * syminfo.mintick and not na(recentPivotHigh) and close > recentPivotHigh
    bool higherLowBreak = hasTwoPivotLows and recentPivotLow > prevPivotLow + syminfo.mintick * 0.25 and not na(recentPivotHigh) and close > recentPivotHigh

    bool bullEngulf = close > open and close[1] < open[1] and open <= close[1] and close >= open[1] and strong_body(0)
    bool bullTLS = bar_index >= 4 and close[3] < open[3] and close[2] < open[2] and close[1] < open[1] and close[2] < close[3] and close[1] < close[2] and close > open and open <= close[1] and close >= open[3] and strong_body(0)
    bool bullFlushFlip = bar_index >= 3 and close[2] < open[2] and strong_body(2) and close[1] > open[1] and close > open and strong_body(1) and strong_body(0) and close > high[2]
    bool bullFallback = close > open and close > high[1]
    bool bullContinuation = useContinuationPattern and emaLongOk and htfLongOk and close > open and close > high[1] and continuationLow <= emaFast

    if bullContinuation
        longSignal := true
        longTrigger := high
        longAnchor := continuationLow
    else if enableHigherLowBreak and higherLowBreak
        longSignal := true
        longTrigger := math.max(high, recentPivotHigh)
        longAnchor := recentPivotLow
    else if enableDoubleBottom and dblBottom
        longSignal := true
        longTrigger := math.max(high, recentPivotHigh)
        longAnchor := math.min(recentPivotLow, prevPivotLow)
    else if enableEngulfing and bullEngulf
        longSignal := true
        longEngulfingSignal := true
        longTrigger := high
        longAnchor := math.min(low, low[1])
    else if enableThreeLineStrike and bullTLS
        longSignal := true
        longTrigger := high
        longAnchor := math.min(math.min(low, low[1]), math.min(low[2], low[3]))
    else if bullFlushFlip
        longSignal := true
        longTrigger := high
        longAnchor := math.min(math.min(low, low[1]), low[2])
    else if enableFallbackPattern and bullFallback
        longSignal := true
        longTrigger := high
        longAnchor := low

    int longPatternScore = 0
    longPatternScore += higherLowBreak ? 1 : 0
    longPatternScore += dblBottom ? 1 : 0
    longPatternScore += bullEngulf ? 1 : 0
    longPatternScore += bullTLS ? 1 : 0
    longPatternScore += bullFlushFlip ? 1 : 0
    longPatternScore += bullContinuation ? 2 : 0
    longPatternScore += (enableFallbackPattern and bullFallback) ? 1 : 0
    bool longPatternScorePass = longPatternScore >= minPatternScore

    bool longSignalStrengthOK = not requireEngulfingOrStrongClose or longEngulfingSignal or strong_body(0) or (close > open and close >= high[1])
    bool longZonePass = not effectiveRequireZone or longZoneOK
    bool longTrendPass = not effectiveRequireTrend or longTrendOK
    int longPrecisionScore = 0
    longPrecisionScore += longZoneOK ? 1 : 0
    longPrecisionScore += longTrendOK ? 1 : 0
    longPrecisionScore += volatilityOK ? 1 : 0
    longPrecisionScore += emaLongOk ? 1 : 0
    longPrecisionScore += htfLongOk ? 1 : 0
    longPrecisionScore += rsiLongOk ? 1 : 0
    longPrecisionScore += vwapLongOk ? 1 : 0
    longPrecisionScore += adxOk ? 1 : 0
    longPrecisionScore += strong_body(0) ? 1 : 0
    bool longPrecisionPass = not effectivePrecisionMode or (longPrecisionScore >= precisionMinScore and emaLongOk and htfLongOk and rsiLongOk and vwapLongOk and adxOk and strong_body(0))

    bool longPlanReady = false
    int longQty = 0
    float longEntry = na
    float longStop = na
    float longTarget = na

    if longSignal and longPatternScorePass and longSignalStrengthOK and longZonePass and longTrendPass and longPrecisionPass
        visLongSetup := true
    if longZonePass and longTrendPass and longSignal and longPatternScorePass and longSignalStrengthOK and longPrecisionPass
        longEntry := round_to_tick(longTrigger + entryOffsetTicks * syminfo.mintick)
        float longExecRef = useStopEntryMode ? longEntry : round_to_tick(close)
        float stopRawLong = stopMethod == "FixedTicks" ? (longExecRef - fixedStopTicks * syminfo.mintick) : stopMethod == "SignalBar" ? (longAnchor - stopBufferTicks * syminfo.mintick) : (math.min(longAnchor, swingBaseLow) - stopBufferTicks * syminfo.mintick)
        longStop := round_to_tick(stopRawLong)
        float stopTicksLong = (longExecRef - longStop) / syminfo.mintick

        bool longStopFilterPass = stopTicksLong > 0 and (not enforceMaxStopFilter or stopTicksLong <= maxStopTicks)
        if longStop < longExecRef and longStopFilterPass
            longQty := calc_contracts(longExecRef, longStop, pointValue)
            if longQty > 0
                float rrTarget = longExecRef + (longExecRef - longStop) * effectiveTargetR
                if useZoneTargets
                    float zoneTarget = find_zone_target(true, longExecRef)
                    rrTarget := na(zoneTarget) ? rrTarget : math.min(rrTarget, zoneTarget)
                longTarget := round_to_tick(rrTarget)
                longPlanReady := longTarget > longExecRef + syminfo.mintick

    // ---- Short pattern stack ----
    bool shortSignal = false
    bool shortEngulfingSignal = false
    float shortTrigger = na
    float shortAnchor = na

    bool lowerHighBreak = hasTwoPivotHighs and recentPivotHigh < prevPivotHigh - syminfo.mintick * 0.25 and not na(recentPivotLow) and close < recentPivotLow
    bool bearEngulf = close < open and close[1] > open[1] and open >= close[1] and close <= open[1] and strong_body(0)
    bool bearTLS = bar_index >= 4 and close[3] > open[3] and close[2] > open[2] and close[1] > open[1] and close[2] > close[3] and close[1] > close[2] and close < open and open >= close[1] and close <= open[3] and strong_body(0)
    bool bearFlushFlip = bar_index >= 3 and close[2] > open[2] and strong_body(2) and close[1] < open[1] and close < open and strong_body(1) and strong_body(0) and close < low[2]
    bool bearFallback = close < open and close < low[1]
    bool bearContinuation = useContinuationPattern and emaShortOk and htfShortOk and close < open and close < low[1] and continuationHigh >= emaFast

    if bearContinuation
        shortSignal := true
        shortTrigger := low
        shortAnchor := continuationHigh
    else if enableHeadAndShoulders and lowerHighBreak
        shortSignal := true
        shortTrigger := math.min(low, recentPivotLow)
        shortAnchor := math.max(recentPivotHigh, prevPivotHigh)
    else if enableEngulfing and bearEngulf
        shortSignal := true
        shortEngulfingSignal := true
        shortTrigger := low
        shortAnchor := math.max(high, high[1])
    else if enableThreeLineStrike and bearTLS
        shortSignal := true
        shortTrigger := low
        shortAnchor := math.max(math.max(high, high[1]), math.max(high[2], high[3]))
    else if bearFlushFlip
        shortSignal := true
        shortTrigger := low
        shortAnchor := math.max(math.max(high, high[1]), high[2])
    else if enableFallbackPattern and bearFallback
        shortSignal := true
        shortTrigger := low
        shortAnchor := high

    int shortPatternScore = 0
    shortPatternScore += lowerHighBreak ? 1 : 0
    shortPatternScore += bearEngulf ? 1 : 0
    shortPatternScore += bearTLS ? 1 : 0
    shortPatternScore += bearFlushFlip ? 1 : 0
    shortPatternScore += bearContinuation ? 2 : 0
    shortPatternScore += (enableFallbackPattern and bearFallback) ? 1 : 0
    bool shortPatternScorePass = shortPatternScore >= minPatternScore

    bool shortSignalStrengthOK = not requireEngulfingOrStrongClose or shortEngulfingSignal or strong_body(0) or (close < open and close <= low[1])
    bool shortZonePass = not effectiveRequireZone or shortZoneOK
    bool shortTrendPass = not effectiveRequireTrend or shortTrendOK
    int shortPrecisionScore = 0
    shortPrecisionScore += shortZoneOK ? 1 : 0
    shortPrecisionScore += shortTrendOK ? 1 : 0
    shortPrecisionScore += volatilityOK ? 1 : 0
    shortPrecisionScore += emaShortOk ? 1 : 0
    shortPrecisionScore += htfShortOk ? 1 : 0
    shortPrecisionScore += rsiShortOk ? 1 : 0
    shortPrecisionScore += vwapShortOk ? 1 : 0
    shortPrecisionScore += adxOk ? 1 : 0
    shortPrecisionScore += strong_body(0) ? 1 : 0
    bool shortPrecisionPass = not effectivePrecisionMode or (shortPrecisionScore >= precisionMinScore and emaShortOk and htfShortOk and rsiShortOk and vwapShortOk and adxOk and strong_body(0))

    bool shortPlanReady = false
    int shortQty = 0
    float shortEntry = na
    float shortStop = na
    float shortTarget = na

    if shortSignal and shortPatternScorePass and shortSignalStrengthOK and shortZonePass and shortTrendPass and shortPrecisionPass
        visShortSetup := true
    if shortZonePass and shortTrendPass and shortSignal and shortPatternScorePass and shortSignalStrengthOK and shortPrecisionPass
        shortEntry := round_to_tick(shortTrigger - entryOffsetTicks * syminfo.mintick)
        float shortExecRef = useStopEntryMode ? shortEntry : round_to_tick(close)
        float stopRawShort = stopMethod == "FixedTicks" ? (shortExecRef + fixedStopTicks * syminfo.mintick) : stopMethod == "SignalBar" ? (shortAnchor + stopBufferTicks * syminfo.mintick) : (math.max(shortAnchor, swingBaseHigh) + stopBufferTicks * syminfo.mintick)
        shortStop := round_to_tick(stopRawShort)
        float stopTicksShort = (shortStop - shortExecRef) / syminfo.mintick

        bool shortStopFilterPass = stopTicksShort > 0 and (not enforceMaxStopFilter or stopTicksShort <= maxStopTicks)
        if shortStop > shortExecRef and shortStopFilterPass
            shortQty := calc_contracts(shortExecRef, shortStop, pointValue)
            if shortQty > 0
                float rrTarget = shortExecRef - (shortStop - shortExecRef) * effectiveTargetR
                if useZoneTargets
                    float zoneTarget = find_zone_target(false, shortExecRef)
                    rrTarget := na(zoneTarget) ? rrTarget : math.max(rrTarget, zoneTarget)
                shortTarget := round_to_tick(rrTarget)
                shortPlanReady := shortTarget < shortExecRef - syminfo.mintick

    // If both plans are valid, prefer the side closer to its zone.
    if longPlanReady and shortPlanReady
        if longDistTicks <= shortDistTicks
            shortPlanReady := false
        else
            longPlanReady := false

    if longPlanReady
        visLongSetup := true
        if useStopEntryMode
            strategy.entry("L", strategy.long, qty = longQty, stop = longEntry, alert_message = build_entry_message("long", longQty, longEntry, longStop, longTarget, timingBucket))
        else
            strategy.entry("L", strategy.long, qty = longQty, alert_message = build_entry_message("long", longQty, close, longStop, longTarget, timingBucket))
        plannedStop := longStop
        plannedTarget := longTarget
        plannedEntry := useStopEntryMode ? longEntry : close
        pendingLong := useStopEntryMode
        pendingShort := false
        pendingTimingBucket := effectiveRequireTiming ? timingBucket : 0
        pendingBar := bar_index
        visLongOrderSent := true

    else if shortPlanReady
        visShortSetup := true
        if useStopEntryMode
            strategy.entry("S", strategy.short, qty = shortQty, stop = shortEntry, alert_message = build_entry_message("short", shortQty, shortEntry, shortStop, shortTarget, timingBucket))
        else
            strategy.entry("S", strategy.short, qty = shortQty, alert_message = build_entry_message("short", shortQty, close, shortStop, shortTarget, timingBucket))
        plannedStop := shortStop
        plannedTarget := shortTarget
        plannedEntry := useStopEntryMode ? shortEntry : close
        pendingShort := useStopEntryMode
        pendingLong := false
        pendingTimingBucket := effectiveRequireTiming ? timingBucket : 0
        pendingBar := bar_index
        visShortOrderSent := true

// -----------------------------
// Visual aids
// -----------------------------
bool rawBullPattern = close > open and close > high[1]
bool rawBearPattern = close < open and close < low[1]

plot(showPendingEntryLine and pendingOrderExists ? plannedEntry : na, "Pending Entry", color = color.new(color.yellow, 0), linewidth = 2, style = plot.style_linebr)
plot(strategy.position_size != 0 ? activeStop : na, "Active Stop", color = color.new(color.red, 0), linewidth = 2, style = plot.style_linebr)
plot(strategy.position_size != 0 ? activeTarget : na, "Active Target", color = color.new(color.green, 0), linewidth = 2, style = plot.style_linebr)
plot(cashOpenTriggered ? minutesFromOpen : na, "MinutesFromOpen", color = color.new(color.blue, 70), display = display.none)
plotshape(showSetupMarkers and relaxModeActive, title = "Auto Relax Active", style = shape.square, location = location.bottom, color = color.new(color.orange, 0), size = size.tiny, text = "RELAX")

plotshape(showSignalMarkers and visLongOrderSent, title = "Buy Order Sent", style = shape.triangleup, location = location.belowbar, color = color.new(color.lime, 0), size = size.small, text = "BUY")
plotshape(showSignalMarkers and visShortOrderSent, title = "Sell Order Sent", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0), size = size.small, text = "SELL")
plotshape(showSetupMarkers and visLongSetup, title = "Long Setup", style = shape.circle, location = location.belowbar, color = color.new(color.green, 70), size = size.tiny, text = "LS")
plotshape(showSetupMarkers and visShortSetup, title = "Short Setup", style = shape.circle, location = location.abovebar, color = color.new(color.red, 70), size = size.tiny, text = "SS")
plotshape(showSignalMarkers and newLongFill, title = "Long Filled", style = shape.labelup, location = location.belowbar, color = color.new(color.teal, 0), textcolor = color.white, size = size.tiny, text = "LONG FILLED")
plotshape(showSignalMarkers and newShortFill, title = "Short Filled", style = shape.labeldown, location = location.abovebar, color = color.new(color.orange, 0), textcolor = color.white, size = size.tiny, text = "SHORT FILLED")

plotshape(showRawPatternMarkers and rawBullPattern, title = "Raw Bull Pattern", style = shape.circle, location = location.belowbar, color = color.new(color.lime, 70), size = size.tiny, text = "B")
plotshape(showRawPatternMarkers and rawBearPattern, title = "Raw Bear Pattern", style = shape.circle, location = location.abovebar, color = color.new(color.red, 70), size = size.tiny, text = "S")

